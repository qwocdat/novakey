rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /public/{path=**} {
      allow read: if true;
      // Replace REPLACE_WITH_ADMIN_UID with the same admin UID used in adminUsers/{UID}.
      // The UID must be a literal string in Firebase Storage Rules.
      allow write: if request.auth != null
        && request.auth.uid == 'REPLACE_WITH_ADMIN_UID'
        && (
          request.resource == null
          || (request.resource.size < 5 * 1024 * 1024
              && request.resource.contentType.matches('image/.*'))
        );
    }
  }
}
